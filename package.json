{
  "name": "osis-sman3-rembang",
  "version": "2.0.0",
  "private": true,
  "description": "Website & panel admin OSIS SMA Negeri 3 Rembang Periode 2026/2027 (React + Supabase)",
  "allowScripts": {
    "@electric-sql/pglite": true
  },
  "scripts": {
    "setup": "npm install && npm install --prefix client",
    "dev": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "preview": "npm run preview --prefix client",
    "test:db": "node supabase/tests/db.test.mjs",
    "build:sql": "node scripts/build-setup-sql.mjs",
    "db:patch": "node scripts/apply-access-patch.mjs",
    "db:patch:api": "node scripts/apply-access-patch-api.mjs",
    "admin:create": "node scripts/create-superadmin.mjs",
    "deploy": "npx vercel --prod --cwd client",
    "deploy:preview": "npx vercel --cwd client"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "pg": "^8.23.0",
    "supabase": "^2.118.0"
  }
}
